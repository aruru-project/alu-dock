{
  "name": "alu-dock",
  "version": "0.1.0",
  "private": true,
  "description": "Host-owned Pi SDK runtime dock for SSH workflows",
  "type": "module",
  "bin": {
    "alu-dock": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "cli": "npm run build && node dist/src/cli.js",
    "serve": "npm run build && node dist/src/cli.js serve",
    "smoke:sdk": "npm run build && node dist/scripts/sdk-smoke.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
