{
  "name": "alu-dock",
  "version": "0.2.0",
  "private": true,
  "description": "Host-owned Pi SDK runtime dock for SSH workflows",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "aludock": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:sdk-upgrade": "npm run build && node --test dist/test/pi-sdk-compat/**/*.compat.js",
    "test:client-protocol": "npm run build && cargo build --locked --manifest-path clients/official/Cargo.toml -p aludock-client-core --example protocol_inventory --example protocol_files --example protocol_records && node --test dist/test/client-protocol/*.compat.js",
    "cli": "npm run build && node dist/src/cli.js",
    "serve": "npm run build && ALU_DOCK_SOCKET=${ALU_DOCK_SOCKET:-${XDG_RUNTIME_DIR:-$HOME/.alu-dock/run}/alu-dock-dev.sock} node dist/src/cli.js serve --dev",
    "smoke:sdk": "npm run build && node dist/scripts/sdk-smoke.js",
    "bench:tui": "npm run build && node --expose-gc dist/scripts/tui-render-benchmark.js",
    "client:install": "cd clients/official && corepack pnpm install --frozen-lockfile",
    "client:dev": "cd clients/official && corepack pnpm dev",
    "client:build": "cd clients/official && corepack pnpm build",
    "client:test": "cd clients/official && corepack pnpm test",
    "client:check": "cd clients/official && corepack pnpm check && corepack pnpm build",
    "client:package:linux": "cd clients/official && corepack pnpm package:linux",
    "package:windows": "cd clients/official && corepack pnpm package:windows",
    "prepack": "npm run build",
    "install:local": "node scripts/ensure-locked-dependencies.mjs && npm run build && node dist/scripts/install-local.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "https://github.com/aruru-project/pi/releases/download/dock-v0.99.2-dock.1/earendil-works-pi-coding-agent-0.99.2-dock.1.tgz",
    "@earendil-works/pi-tui": "https://github.com/aruru-project/pi/releases/download/dock-v0.99.2-dock.1/earendil-works-pi-tui-0.99.2-dock.1.tgz",
    "@peculiar/x509": "2.0.0",
    "fast-srp-hap": "2.0.4",
    "reflect-metadata": "0.2.2",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
